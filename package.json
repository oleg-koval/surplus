{
  "name": "surplus-cli",
  "version": "0.4.0",
  "description": "Use more of your included AI coding allowance before it resets.",
  "type": "module",
  "license": "MIT",
  "author": "Oleg Koval",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleg-koval/surplus.git"
  },
  "homepage": "https://github.com/oleg-koval/surplus#readme",
  "bugs": {
    "url": "https://github.com/oleg-koval/surplus/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "hermes-agent",
    "pi-coding-agent",
    "cli",
    "ai",
    "usage",
    "rate-limit"
  ],
  "engines": {
    "node": "^22.21.0 || >=24.10.0"
  },
  "bin": {
    "surplus": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "demo": "node dist/cli.js demo",
    "surplus": "node dist/cli.js",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs",
    "prepare": "npm run build",
    "ci": "npm run typecheck && npm run lint && npm test",
    "semantic-release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.26.0",
    "semantic-release": "^25.0.9",
    "semantic-release-npm-github-publish": "^1.7.7",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^4.1.11"
  }
}
